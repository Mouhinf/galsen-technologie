generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String
  subject   String
  content   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String   @default("")
  icon        String   @default("Code2")
  color       String   @default("#22C55E")
  features    String   @default("[]")
  imageUrl    String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  client      String?
  year        String?
  description String
  content     String   @default("")
  techStack   String   @default("[]")
  imageUrl    String
  liveUrl     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  imageUrl    String
  category    String
  tags        String   @default("[]")
  author      String   @default("Galsen Technologie")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String   @default("")
  content   String
  rating    Int      @default(5)
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formation {
  id          String   @id @default(cuid())
  title       String
  level       String
  duration    String
  price       String
  description String
  schedule    String
  instructor  String
  color       String   @default("#22C55E")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  referrer  String?
  userAgent String?
  country   String?
  city      String?
  region    String?
  device    String   @default("desktop")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserAction {
  id         String   @id @default(cuid())
  sessionId  String
  actionType String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actionType])
  @@index([sessionId])
}
